CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
API_HOST=0.0.0.0
API_PORT=8001
# Required for AI Scouting Report and GM Assistant features:
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Unlocks POST /predictions/setup and POST /lineups/model/train, sent as an
# X-Admin-Token header. Leave empty in production: the hosted site serves
# pre-trained snapshots and never needs to train.
ADMIN_TOKEN=
# Hard ceiling on Anthropic tokens per UTC day across ALL callers -- the
# actual cap on your bill. 0 disables it.
DAILY_TOKEN_BUDGET=500000
# Per-IP ceiling for ordinary endpoints. The AI routes set their own.
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_ENABLED=true
# Proxies in front of the app, for reading X-Forwarded-For. 1 = Render.
TRUSTED_PROXY_HOPS=1
